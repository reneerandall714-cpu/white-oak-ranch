# Copy to .env.staging.local (ignored by Git) after provisioning a DISTINCT project.
# This file contains only public client configuration; never put a service key here.
EXPO_PUBLIC_SUPABASE_ENV=staging
EXPO_PUBLIC_STAGING_PROJECT_REF=replace-with-distinct-staging-project-ref
EXPO_PUBLIC_SUPABASE_URL=https://replace-with-distinct-staging-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
# Set to true only after staging integration tests and backend review pass.
EXPO_PUBLIC_BOOKING_REQUESTS_VERIFIED=false
# Keep false until Square Sandbox payment, refund, webhook and expiry checks pass.
EXPO_PUBLIC_SQUARE_SANDBOX_VERIFIED=false
# HTTPS origin used to build the customer link staff can share manually.
EXPO_PUBLIC_CHECKOUT_BASE_URL=https://your-staging-app.example
